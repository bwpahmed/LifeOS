  "cards": [
    {
      "dot": "emerald",
      "title": "Authority",
      "items": [
        "Supabase + RLS own durable cloud truth",
        "lib/ owns reusable domain rules",
        "local cache/queue is never a second database"
      ]
    },
    {
      "dot": "rose",
      "title": "Privacy",
      "items": [
        "middleware + Supabase Auth guard requests",
        "RLS is cloud authorization",
        "privacy-gate is only an on-device UI lock"
