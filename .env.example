# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://xyz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy fallback is still supported:
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=keep-server-only-never-expose-to-client

# Public deployment origin (optional, used by OpenRouter attribution)
NEXT_PUBLIC_SITE_URL=

# AI (server-only; never NEXT_PUBLIC_). If no key is set, LifeOS uses a labeled deterministic fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Scheduled reminders + Web Push
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> automatically when configured.
CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
